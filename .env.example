# Environment Variables Example for BlaBlaBikes
# Copy this file to .env.local and populate the secrets.
# DO NOT commit .env.local to version control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Direct connection for Drizzle ORM migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Upstash Redis (Optional for rate limiting in dev; in-memory fallback is active if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Maps & Geo (Nashik Boundaries)
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_NASHIK_BBOX="73.68,19.90,73.90,20.08"
NEXT_PUBLIC_FUEL_COST_PER_KM_CEILING=4.00

# Safety & Support Contacts (Nashik Local Helpline)
NEXT_PUBLIC_EMERGENCY_NUMBER_POLICE=112
NEXT_PUBLIC_EMERGENCY_NUMBER_WOMEN=1091
