# ==============================================================================
# BlaBlaBikes - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real secrets!
# ==============================================================================

# App Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase (PostgreSQL, Auth & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Direct Connection (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Email (Resend)
RESEND_API_KEY=re_dev_placeholder_key
EMAIL_FROM="BlaBlaBikes Nashik <notifications@blablabikes.in>"
SUPPORT_EMAIL=support@blablabikes.in

# Upstash Redis (Optional for rate limiting in dev; in-memory fallback is active if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Maps & Nashik Limits
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_NASHIK_BBOX="73.68,19.90,73.90,20.08"
NEXT_PUBLIC_FUEL_COST_PER_KM_CEILING=4.00

# Emergency Hotlines (India & Maharashtra)
NEXT_PUBLIC_EMERGENCY_NUMBER_POLICE=112
NEXT_PUBLIC_EMERGENCY_NUMBER_WOMEN=1091

