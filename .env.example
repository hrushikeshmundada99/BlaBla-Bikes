# Environment Variables Example for BlaBlaBikes
# Copy this file to .env.local and populate the secrets.
# DO NOT commit .env.local to version control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Direct connection for Drizzle ORM migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Upstash Redis (Optional for rate limiting in dev; in-memory fallback is active if empty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Maps (Leaflet & OpenStreetMap)
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Safety & Support Contacts (Nashik Local Helpline)
NEXT_PUBLIC_EMERGENCY_NUMBER_POLICE=112
NEXT_PUBLIC_EMERGENCY_NUMBER_WOMEN=1091
